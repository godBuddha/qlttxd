# HTTP
PORT=3000
HOST=0.0.0.0

# PostgreSQL/PostGIS. Khi chạy toolchain cục bộ có thể đặt PGHOST=/tmp.
PGHOST=localhost
PGPORT=5432
PGDATABASE=qlttxd
PGUSER=qlttxd
PGPASSWORD=doi-mat-khau-khi-trien-khai

# Bảo mật và lưu tệp (không commit .env thật).
# JWT_SECRET bắt buộc >=32 ký tự; backend từ chối khởi động nếu thiếu/yếu.
JWT_SECRET=thay-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Chỉ origin frontend được phép gọi API khác origin; để trống sẽ không phát CORS.
CORS_ORIGIN=https://qlttxd.example.gov.vn
UPLOAD_DIR=./uploads

# SMTP (lớp A — secret, chỉ nằm ở env; KHÔNG đưa vào DB).
# smtp.enabled/host/port/from_address được quản lý qua Settings Center (DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# LƯU Ý (Wave 1 / HC-03): các biến MAX_UPLOAD_MB, AUDIT_RETENTION_DAYS,
# AUDIT_BATCH_SIZE, RATE_LIMIT_MAX, REQUEST_TIMEOUT_MS đã BỎ override qua env.
# Giá trị tương ứng giờ quản lý tập trung qua Settings Center:
#   upload.max_mb, audit.retention_days, audit.batch_size,
#   rate_limit.forgot_max, security.request_timeout_ms.
# Đặt các biến cũ trong .env sẽ KHÔNG còn tác dụng.
# Giá trị fallback trong code khi Settings Center chưa có dữ liệu:
#   upload.max_mb = 10 MB · audit.retention_days = 7300 ngày (20 năm)
#   audit.batch_size = 500 dòng/lượt xóa · security.request_timeout_ms = 30000 ms
#   rate_limit.global_window_ms = 900000 · rate_limit.global_max = 100
#   rate_limit.write_max = 30 · rate_limit.user_max = 200
#   pool.max = 20 · pool.idle_timeout_ms = 30000 · pool.connect_timeout_ms = 5000

# Biến nghiệp vụ code ĐANG đọc trực tiếp từ env:
# Origin frontend dùng khi tạo link đặt lại mật khẩu trong email.
FRONTEND_URL=http://localhost:5173
# Mức log: debug | info | warn | error (mặc định info).
LOG_LEVEL=info
# Tắt rate-limit (chỉ nên dùng khi test/dev). Mặc định: bật rate-limit.
RATE_LIMIT_DISABLED=false

# ===== CHỈ DÙNG KHI TEST / DEV — KHÔNG BẬT Ở PRODUCTION =====
# QLTTXD_DEBUG_TOKENS=true sẽ in token JWT ra log khi NODE_ENV != production — rò rỉ credential.
QLTTXD_DEBUG_TOKENS=false
# TEST_ADMIN_PASSWORD chỉ được test-suite backend dùng (qua test/test-config.js), không ảnh hưởng server chạy thật.
TEST_ADMIN_PASSWORD=

# ===== THƯ VIỆN (pg driver đọc trực tiếp, không qua code ứng dụng) =====
# Thời gian chờ kết nối PostgreSQL tính bằng giây (pg connection-parameters); mặc định của driver: 0 (không giới hạn).
PGCONNECT_TIMEOUT=0
# Chế độ SSL kết nối PostgreSQL: disable | allow | prefer | require (mặc định prefer).
PGSSLMODE=prefer
