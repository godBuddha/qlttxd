# HTTP
PORT=3000
HOST=0.0.0.0

# PostgreSQL/PostGIS. Khi chạy toolchain cục bộ có thể đặt PGHOST=/tmp.
PGHOST=localhost
PGPORT=5432
PGDATABASE=qlttxd
PGUSER=qlttxd
PGPASSWORD=doi-mat-khau-khi-trien-khai

# Bảo mật và lưu tệp (không commit .env thật).
# JWT_SECRET bắt buộc >=32 ký tự; backend từ chối khởi động nếu thiếu/yếu.
JWT_SECRET=thay-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Chỉ origin frontend được phép gọi API khác origin; để trống sẽ không phát CORS.
CORS_ORIGIN=https://qlttxd.example.gov.vn
UPLOAD_DIR=./uploads

# SMTP (lớp A — secret, chỉ nằm ở env; KHÔNG đưa vào DB).
# smtp.enabled/host/port/from_address được quản lý qua Settings Center (DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# LƯU Ý (Wave 1 / HC-03): các biến MAX_UPLOAD_MB, AUDIT_RETENTION_DAYS,
# AUDIT_BATCH_SIZE, RATE_LIMIT_MAX, REQUEST_TIMEOUT_MS đã BỎ override qua env.
# Giá trị tương ứng giờ quản lý tập trung qua Settings Center:
#   upload.max_mb, audit.retention_days, audit.batch_size,
#   rate_limit.forgot_max, security.request_timeout_ms.
# Đặt các biến cũ trong .env sẽ KHÔNG còn tác dụng.
