# Sử dụng: cp .env.example .env && chỉnh sửa giá trị bên dưới

# --- PostgreSQL ---
POSTGRES_PASSWORD=thay-mat-khau-manh-tai-day

# --- Backend ---
# JWT secret: tối thiểu 32 ký tự, dùng openssl rand -hex 32 để tạo
JWT_SECRET=thay-chuoi-bi-mat-it-nhat-32-ky-tu-tai-day

# CORS origin: domain frontend khi deploy (dùng http://localhost cho dev)
CORS_ORIGIN=http://localhost

# --- Caddy (reverse proxy) ---
# Domain: localhost cho dev, domain thật cho staging/production
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
