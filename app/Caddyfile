{$DOMAIN:localhost} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # Health check — must be before SPA fallback so /health returns JSON, not HTML
    handle /health {
        reverse_proxy http://backend:3001
    }

    # Backend API proxy
    handle /api/* {
        reverse_proxy http://backend:3001
    }

    # Uploads proxy
    handle /uploads/* {
        reverse_proxy http://backend:3001
    }

    # Frontend static files (built by Vite) — SPA fallback
    root * /srv
    try_files {path} /index.html
    file_server
}
