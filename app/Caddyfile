{$DOMAIN:localhost} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # Health check — must be before SPA fallback so /health returns JSON, not HTML
    handle /health {
        reverse_proxy http://backend:3001
    }

    # Frontend static files (built by Vite)
    root * /srv
    file_server {
        try_files {path} /index.html
    }

    # Backend API proxy
    reverse_proxy /api/* http://backend:3001
    reverse_proxy /uploads/* http://backend:3001
}
